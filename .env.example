# Copy to .env (gitignored). ercot-mis reads it automatically; real environment
# variables take precedence.
ERCOT_DUNS=your-duns-plus-4
ERCOT_API_USER=API_YOURID

# Public API credentials. Prefer the macOS Keychain over this file; ercot-mis looks
# there when a variable is unset (see "Credentials" in the README):
#   security add-generic-password -s ercot-mis -a ERCOT_PUBLIC_API_PASSWORD -w
# ERCOT_PUBLIC_API_USERNAME=<your apiexplorer sign-in email>
# ERCOT_PUBLIC_API_PASSWORD=<your apiexplorer password>
# ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=<Primary key>

# Optional. These are the defaults.
# ERCOT_CERT=~/.ercot/api.crt
# ERCOT_KEY=~/.ercot/api.key
# ERCOT_MIS_DATA=<this repo>/data
